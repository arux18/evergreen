                  "fontSize": "$typo-primary-sm-semibold-font-size",
                  "fontWeight": "600",
                  "letterSpacing": "$typo-primary-sm-semibold-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "fZXyl",
                  "name": "What it is",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What it is\nA low-level layout primitive that arranges children vertically or horizontally with consistent spacing. Stack is the foundation for higher-level components like Card, Buttons, FormField, Accordion, TagBlock, Steps, PageLayout, and chat blocks.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "GHuCN",
                  "name": "When to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Arrange elements in a single direction with consistent gap\n• Control cross-axis alignment and main-axis distribution\n• Build layout scaffolding inside any component",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "S5VlQ8",
                  "name": "When not to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Two-dimensional grid layouts (use Grid)\n• Visual container with background, border, or shadow (use Card or Surface)\n• Semantic landmark (use Section, Nav, or Article)",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "yphnp",
                  "name": "Props",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Props / Defaults\n• direction: vertical | horizontal  →  vertical\n• gap: none(0) | xs(12) | sm(16) | md(24) | lg(32) | xl(40)  →  md\n• align: start | center | end | stretch  →  stretch\n• justify: start | center | end | between  →  start\n• wrap: false | true  →  false",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "AcT2W",
                  "name": "Token usage",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• gap.none = 0\n• gap.xs = $spacing-xs (12px)\n• gap.sm = $spacing-sm (16px)\n• gap.md = $spacing-md (24px)\n• gap.lg = $spacing-lg (32px)\n• gap.xl = $spacing-xl (40px)",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "hBcLz",
                  "name": "Accessibility",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nStack has no semantic meaning; it renders as a plain container (div). Parent components must provide appropriate ARIA roles, landmarks, or headings when needed.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                }
              ]
            }
