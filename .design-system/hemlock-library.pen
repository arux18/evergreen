                  "content": "TextContent",
                  "lineHeight": 1.3333,
                  "fontFamily": "$typo-primary-xl-bold-font-family",
                  "fontSize": "$typo-primary-xl-bold-font-size",
                  "fontWeight": "700",
                  "letterSpacing": "$typo-primary-xl-bold-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "Gr4Df",
                  "name": "Docs Subtitle",
                  "fill": "$colors-text-meta",
                  "content": "Prose Text Primitive",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-semibold-font-family",
                  "fontSize": "$typo-primary-sm-semibold-font-size",
                  "fontWeight": "600",
                  "letterSpacing": "$typo-primary-sm-semibold-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "XvZWz",
                  "name": "Purpose",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nSimple prose wrapper for body copy, descriptions, hints, and short text blocks. Intended for Card, Callout, MarkdownRenderer, chat blocks, FormField, and other OpenUI-oriented surfaces.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "D0KxzW",
                  "name": "When to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Paragraph-style helper text and descriptions\n• Supplementary copy inside compound components\n• Inline prose where typography and tone must stay token-driven",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "BF4TG",
                  "name": "When not to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Headings or titles (use heading typography)\n• Markdown or rich rendering (use MarkdownRenderer)\n• Validation or error messaging (use FormField)\n• Containers needing background, border, radius, or shadow",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "MiY63",
                  "name": "Variants",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants / Defaults\n• size: sm | md | lg  →  md\n• tone: default | muted | strong  →  default\n• align: left | center | right  →  left",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "O82TYQ",
                  "name": "Token usage",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• size.sm + tone.default → typo-primary-sm-regular + $colors-text-body\n• size.md + tone.default → typo-primary-base-regular + $colors-text-body\n• size.lg + tone.default → typo-primary-md-regular + $colors-text-body\n• tone.muted → $colors-text-meta (same scale)\n• tone.strong → typo-primary-*-semibold + $colors-text-header\n• align maps to text alignment on the content text.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "h5yxcF",
                  "name": "Accessibility",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nTextContent does not define landmark semantics by itself. The consuming component should supply the appropriate element (paragraph, section, article, list item, etc.) and any needed ARIA attributes.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                }
              ]
