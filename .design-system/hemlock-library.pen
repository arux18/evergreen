                  "id": "THC2y",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nDecorative separators should be hidden from assistive technology (aria-hidden=\"true\"). Meaningful separators that convey structure should expose role=\"separator\" with proper aria-orientation (horizontal or vertical).",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
