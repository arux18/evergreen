              "type": "text",
              "id": "npQgQ",
              "fill": "#2D2926",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "const count = useMotionValue(0)\nconst rounded = useTransform(() =>\n  `$${Math.round(count.get()).toLocaleString()}`\n)\n\nuseEffect(() => {\n  const controls = animate(count, 2412840, {\n    duration: 3\n  })\n  return () => controls.stop()\n}, [])\n\nreturn <motion.pre style={text}>{rounded}</motion.pre>",
              "lineHeight": 1.55,
              "fontFamily": "Geist Mono",
              "fontSize": 10,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
