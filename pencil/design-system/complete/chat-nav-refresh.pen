            {
              "type": "group",
              "id": "s4Wc5J",
              "layoutPosition": "absolute",
              "x": 339.8699999999999,
              "y": 16,
              "name": "FAB Group",
              "children": [
                {
                  "id": "oCNIm",
                  "type": "ref",
                  "ref": "MzoZn",
                  "name": "navPanelToggle",
                  "layoutPosition": "absolute",
                  "x": 0.13000000000010914,
                  "y": 0
                },
                {
                  "id": "MhHMH",
                  "type": "ref",
                  "ref": "MzoZn",
                  "name": "chatPanelToggle",
                  "layoutPosition": "absolute",
                  "x": 0,
                  "y": 49.88586327077792,
                  "descendants": {
                    "KSlnN": {
                      "library": "lucide",
                      "icon": "message-circle"
                    }
                  }
                }
