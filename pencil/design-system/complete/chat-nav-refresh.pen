                              "type": "frame",
                              "id": "uUCaz",
                              "layoutPosition": "absolute",
                              "x": 312,
                              "y": 16,
                              "name": "Chat / Close Button / Default",
                              "context": "Close button for the chat panel (instance in Dashboard - Default example). 32×32 circle, $g:sem-chatBg fill, arrow-right-to-line icon in prim-blue-600. BORDER IS CONDITIONAL: render no outline at rest. Show the 1px prim-blue-300 border only when content scrolls beneath the button (e.g. messages passing under it) so it stays visually distinct from the content below; keep it borderless when only empty panel background is behind it.",
                              "fill": "$g:sem-chatBg",
                              "cornerRadius": 9999,
                              "stroke": {
                                "type": "color",
                                "color": "$g:sem-chatCloseBorder",
                                "enabled": false
