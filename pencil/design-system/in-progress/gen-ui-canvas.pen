                  "type": "text",
                  "id": "dEIKz",
                  "name": "Flag 3",
                  "fill": "$g:sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Selected pill: Hemlock Button has no selected state, so Yes-No / Selected shows /pressed at rest, the same as Canvas / Save Button / Saved (open decision in spec §10).",
                  "lineHeight": "$g:line-height-sm",
                  "fontFamily": "$font-ui",
                  "fontSize": "$g:text-size-sm",
                  "fontWeight": "normal"
                },
