                  "type": "text",
                  "id": "f6Miz",
                  "name": "Flag 2",
                  "fill": "$g:sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Checked marks: Radio/checked and Checkbox/checked draw the ring, dot, and tick in sem-borders-focus, which is #7094FB at 35% in dark: 1.8:1 on sem-background-elevated, under the 3:1 for UI states. Unchecked rings and boxes use sem-borders-dark: 1.4:1 light, 1.2:1 dark.",
                  "lineHeight": "$g:line-height-sm",
                  "fontFamily": "$font-ui",
                  "fontSize": "$g:text-size-sm",
                  "fontWeight": "normal"
                },
