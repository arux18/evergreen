            {
              "type": "text",
              "id": "p3lAUu",
              "name": "Rules",
              "fill": "$g:sem-text-meta",
              "textGrowth": "fixed-width",
              "width": 1100,
              "content": "Name the topic, not the mood: good and bad news get the same icon, and a decline is still trending-down in sem-icons-info-strong, never red. If two fit, use the more specific one (house, not landmark, for a mortgage). If none fits, use Takeaway / No Icon. Keep out: lightbulb (the Tip's icon), arrows and chevrons (they read as links), check, x, alert, info and help circles (status and help), sparkles (AI), bell (notifications), star and heart (favorites), sun and moon (the theme toggle), plus and minus (controls), vault (reads as a close box at 24px).",
              "lineHeight": "$g:line-height-2xs",
              "fontFamily": "IBM Plex Mono",
              "fontSize": "$g:text-size-2xs",
              "fontWeight": "normal"
