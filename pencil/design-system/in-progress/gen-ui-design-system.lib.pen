                  "name": "rule2D",
                  "fill": "$text.secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Always Heebo. Body at 14–16px (md–lg tokens). Labels and captions at 10–12px (xs–sm tokens). Color follows hierarchy: text.primary for headings and body, text.secondary for supporting descriptions, text.tertiary for captions and metadata.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font.primary",
                  "fontSize": "$font.size.sm",
                  "fontWeight": "normal"
                }
