                  "fill": "$text.secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Heebo (mono) for account numbers, masked values (····1234), and any tabular numeric data. Never show full account numbers — last 4 digits only.",
