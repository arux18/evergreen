                  "fill": "$sem-text-meta",
                  "content": "component / Collapse — 2 variants",
                  "lineHeight": "$line-height-2xs",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-2xs",
                  "fontWeight": "600",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "b75Sp0",
                  "name": "vl1",
                  "fill": "$sem-text-meta",
                  "content": "closed (default)",
                  "fontFamily": "$font-primary",
