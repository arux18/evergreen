                      "content": "BarChart",
                      "fontSize": "$text-size-lg",
                      "fontWeight": "700",
                      "lineHeight": 1.3333
                    }
                  }
                },
                {
                  "id": "c4DFhv",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A grouped bar chart organism for comparing categorical data across multiple series. Built on Card with CardHeader, horizontal grid, grouped bars per category, and ChartLegend (inline-bottom). Each bar group contains one bar per series, aligned at the bottom of the plot area."
                    }
                  }
                },
                {
                  "id": "fwoTV",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
