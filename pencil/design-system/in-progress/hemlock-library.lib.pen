                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "r87kc",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "This is a visual chart component. Dynamic cell sizing from data values, hover/tap states, drill-down interaction, animation, and tooltip display are implementation concerns. Percentage values in cells use typography tokens — they are NOT MoneyText instances. The with-tooltip variant shows how ChartTooltip surfaces detail for selected cells; real hover/focus behavior is implementation-level."
                    }
                  }
                }
              ]
            }
          ]
