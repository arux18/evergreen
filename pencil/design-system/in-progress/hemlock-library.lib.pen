                  "name": "Tokens",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• Field text: typo-primary-base-regular + $colors-text-header\n• Floating label idle: $colors-text-meta; raised / focused: typo-primary-xs-semibold + $colors-text-body\n• Placeholder tone: $colors-text-placeholder\n• Border default: $colors-borders-dark; hover (implementation): $colors-gray-400\n• Focus outline: $colors-borders-focus (2px)\n• Disabled field: $colors-gray-50 fill, $colors-gray-300 stroke, $colors-text-disabled\n• Error field: $colors-red-700 stroke, $colors-red-50 fill; icon $colors-red-400\n• Error caption: typo-primary-sm-semibold + $colors-text-error; spacing below $spacing-3xs\n• Horizontal padding: $spacing-sm; radii: $spacing-3xs",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
