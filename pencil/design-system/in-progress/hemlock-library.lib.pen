                {
                  "id": "t3K4D",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for comparing discrete categories across multiple series: quarterly revenue by product, monthly sales by region, performance by team. The grouped bars make direct comparison easy. Use compact in dense dashboards. Use no-card when embedding inside another container."
                    }
                  }
                },
                {
                  "id": "qy6WV",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "U3zssZ",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for time-series trends — use AreaChart or AreaChartMultiSeries instead. Do not use for a single series with many categories — use a simple horizontal bar list. Do not use with more than 4–5 categories or 4+ series — the bars become too narrow to read."
                    }
                  }
                },
