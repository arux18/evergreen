          "fill": "$sem-text-header",
          "content": "SegmentedControl — Demo Examples",
          "lineHeight": "$line-height-xl",
          "fontFamily": "$font-primary",
          "fontSize": "$text-size-xl",
          "fontWeight": "700"
        },
