            {
              "type": "frame",
              "id": "FTSwA",
              "name": "AreaChartMultiSeries Documentation",
              "width": 640,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "id": "vZlYv",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "AreaChartMultiSeries",
                      "fontSize": "$text-size-lg",
                      "fontWeight": "700",
                      "lineHeight": 1.3333
                    }
                  }
                },
                {
                  "id": "mAIGW",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A multi-series area chart organism for comparing 2–3+ data series over time. Built on Card with CardHeader, ChartLegend (inline-top), overlapping area fills with gradient, multiple line strokes, a scrubber with per-series selected points, and a multi-series ChartTooltip overlay positioned outside the clipped plot area."
                    }
                  }
                },
                {
                  "id": "dwz2J",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "jOOjm",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for comparing multiple metrics over time: portfolio allocation by asset class, revenue by region, multi-product trends. The overlapping areas show relative magnitude and composition. Always include ChartLegend to identify series. Use compact in dense dashboards."
                    }
                  }
                },
                {
                  "id": "sisnV",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "EMrzl",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for a single series — use AreaChart instead. Do not use when series overlap heavily and obscure each other — use a stacked area chart or separate small multiples. Do not use for more than 5 series — colors become hard to distinguish. Use BarChart for categorical comparisons."
                    }
                  }
                },
                {
                  "id": "XJi3B",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Variants",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "type": "frame",
