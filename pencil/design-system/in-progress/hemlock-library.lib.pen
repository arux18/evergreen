                    {
                      "type": "text",
                      "id": "i9QOki",
                      "name": "Purpose",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Purpose\nGeneric avatar/thumbnail molecule for representing entities in lists, tables, and cards. Fixed 32×32 with clipped $radius-2xs corners.\n\nDefault variant uses the Image atom for real photos/logos. Fallback and icon variants provide alternatives when no image is available.",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xWoNf",
                      "name": "When to use",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When to use\n• Media slot in ContentRow, TransactionRow, HoldingsRow\n• User or institution avatar in list items\n• Small entity thumbnails in tables\n• Any UI needing a 32×32 visual identifier",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
