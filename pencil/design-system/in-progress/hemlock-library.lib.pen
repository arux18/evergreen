                {
                  "type": "text",
                  "id": "Q3EFY3",
                  "name": "Docs Subtitle",
                  "fill": "$sem-text-meta",
                  "content": "Multi-line text — floating label (same pattern as Input)",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
