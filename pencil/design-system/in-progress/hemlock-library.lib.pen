                  "descendants": {
                    "FHA10": {
                      "content": "Use for dashboard metric cards, account summaries, financial KPIs, gain/loss summaries, and tax or portfolio metrics. Use positive for gains. Use negative for losses or debits. Use neutral for static rates or percentages. Use accent for highlighted values (e.g. cash position). Use with-sparkline to add trend context. Use compact in dense grids."
                    }
                  }
                },
                {
                  "id": "XqeJW",
                  "type": "ref",
