                  "children": [
                    {
                      "type": "text",
                      "id": "qFPXx",
                      "name": "Docs Title",
                      "fill": "$sem-text-header",
                      "content": "Avatar",
                      "lineHeight": "$line-height-xl",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-xl",
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "tbBEk",
                      "name": "Docs Subtitle",
                      "fill": "$sem-text-meta",
                      "content": "Molecule",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "yqSYZ",
                      "name": "Purpose",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Purpose\nGeneric avatar/thumbnail molecule for representing entities in lists, tables, and cards. Fixed 32×32 with clipped $radius-2xs corners.\n\nDefault variant uses the Image atom for real photos/logos. Fallback and icon variants provide alternatives when no image is available.",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "NzjE9",
                      "name": "When to use",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When to use\n• Media slot in ContentRow, TransactionRow, HoldingsRow\n• User or institution avatar in list items\n• Small entity thumbnails in tables\n• Any UI needing a 32×32 visual identifier",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "eJl9F",
                      "name": "Variants",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Variants\n• default — Image atom ref inside 32×32 clipped frame. Override the Image descendant to set the photo/logo.\n• fallback — Centered initials (up to 2 chars) on $gray-200 background. Override initials text per instance.\n• icon — Centered Lucide icon on $gray-200 background. Override icon name per instance (building-2, user, etc.).",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "TZwaS",
                      "name": "Composition",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Composition\n• Base frame: 32×32, clip: true, cornerRadius: $radius-2xs\n• default: Image atom ref (jqmad) sized to 32×32 with cornerRadius 0 (parent clips)\n• fallback: text node centered with $typo-primary-xs-semibold, fill $colors-text-body, on $gray-200 bg\n• icon: 16×16 Lucide icon centered, fill $colors-text-meta, on $gray-200 bg",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "b5sKC",
                      "name": "Token usage",
                      "fill": "$sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Token usage\n• Size: 32×32 (fixed)\n• Corners: $radius-2xs\n• Fallback bg: $gray-200\n• Fallback text: $colors-text-body, $typo-primary-xs-semibold\n• Icon: $colors-text-meta, 16×16\n• No new tokens needed",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
