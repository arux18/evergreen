                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "KTKWQ",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "BarChart = Card + CardHeader/description + chartBody (chartRow: yAxis + plotArea) + xAxis + ChartLegend/inline-bottom. PlotArea (layout: none, clip: true) contains grid lines and barGroup frames. Each barGroup is a horizontal flex frame (alignItems: end, gap: 3) with bars as rectangles. Bars have cornerRadius [2,2,0,0] (rounded top only). With-tooltip adds ChartTooltip/multi-series (layoutPosition: absolute) inside chartBody, positioned near the selected barGroup. No-card omits the Card wrapper — chartContent sits directly in the component frame."
                    }
                  }
                },
                {
                  "id": "F7i7U",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Token usage",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "t7OR8Q",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Bars: $chart-categorical/color-01, color-02, color-03 per series. Bar width: 16px (default), 12px (compact). Bar radius: $radius-4xs top corners. Grid: $colors-borders-light. Axis: $colors-borders-dark. Labels: $typo-primary-2xs-regular, $colors-text-meta. Legend: ChartLegend/inline-bottom with square markers ($radius-4xs)."
                    }
                  }
                },
                {
                  "id": "yS127",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Resize behavior",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "ghyFs",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Card fills available width. Grid lines extend and clip. Bar groups are absolutely positioned in the plot area — bar positions should be recalculated when the container width changes. X-axis labels distribute via space_between. Legend wraps when width is constrained. Bar width remains fixed (16px) regardless of container width."
                    }
                  }
                },
                {
                  "id": "w1CNo",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Accessibility",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "HGgxd",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "ChartLegend is required for multi-series bar charts. Do not rely on color alone — each series has a text label in the legend. Bars should meet 3:1 non-text contrast against the background. Provide text summary of the data. Axis labels remain readable. Categorical chart colors maintain sufficient contrast against $colors-background-surface."
                    }
                  }
                },
