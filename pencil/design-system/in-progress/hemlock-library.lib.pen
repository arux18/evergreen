                  "descendants": {
                    "FHA10": {
                      "content": "Sparkline colors meet WCAG 2.1 non-text contrast (≥3:1). Green ($colors-text-deposit) on white: ~5:1. Red ($colors-text-error) on white: ~5.6:1. Gray ($colors-text-meta) on white: ~4.5:1. Trend direction is communicated by both color and line direction (visual shape), plus the DataValueIndicator symbol (▲/▼/−). Values are always labeled with text — the line alone does not convey meaning."
                    }
                  }
                },
