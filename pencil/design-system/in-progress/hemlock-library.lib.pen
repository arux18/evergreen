                {
                  "id": "hucif",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for multi-series comparisons — use AreaChartMultiSeries instead. Do not use for categorical comparisons — use BarChart. Do not use when exact values are more important than trend visualization — use a data table."
                    }
