            {
              "type": "frame",
              "id": "W7Fv8a",
              "name": "TimelineScrubberChart Documentation",
              "width": 640,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "id": "wYCdB",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "TimelineScrubberChart",
                      "fontSize": "$text-size-lg",
                      "fontWeight": "700",
                      "lineHeight": 1.3333
                    }
                  }
                },
                {
                  "id": "MfNle",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A time-series chart organism with a timeline range track, phase segments, optional event markers, and optional ChartTooltip. Shows equity vesting progression with Cliff, Vesting, and Hold phases displayed on a colored track below the chart area."
                    }
                  }
                },
                {
                  "id": "orltY",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "F22U1",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for equity vesting timelines, RSU schedules, or any time-series data with distinct phases. Use with-events when key dates (exercise, sale) need to be marked. Use with-tooltip when users need to read exact value, date, phase, and event details at a selected point. Use compact in dense dashboards. Use no-card when embedding inside another container."
                    }
                  }
                },
                {
                  "id": "F7r7gW",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "Wagug",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for simple time-series without phases — use AreaChart. Do not use for comparing multiple series — use DualAxisChart. Do not use for categorical data — use BarChart."
                    }
                  }
                },
                {
                  "id": "FskF2",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Variants",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "ZfxMg",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "default: Card wrapper with CardHeader/description, area chart with sequential gradient fill, timeline track with 3 phase segments (Cliff, Vesting, Hold), phase labels.\nwith-events: Same as default plus dashed vertical event markers with labels (Exercise, Sale) at specific timeline positions.\nwith-tooltip: Same as with-events plus a ChartTooltip/multi-series showing selected date, value (MoneyText), phase, and event at a selected point. Includes a solid selection line and data point dot using the primary line token.\ncompact: 360px width, 150px plot height, fewer Y-axis ticks, reduced X-axis labels.\nno-card: CardHeader + chart without Card wrapper, for embedding in other containers."
                    }
                  }
                },
                {
                  "id": "DdR5n",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Composition",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "u0pzM",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "TimelineScrubberChart = Card + CardHeader/description + chartBody (chartRow with yAxis + plotArea, xAxis, timelineSection) + optional event markers + optional ChartTooltip. PlotArea contains grid lines, axis line, area fill path, line stroke path, optional event markers, and optional selection indicator (line + dot). Timeline section has a horizontal track frame with colored segments and phase labels below. The with-tooltip variant adds a ChartTooltip/multi-series instance inside chartContent with absolute positioning."
                    }
                  }
                },
                {
                  "id": "JcLDI",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Token usage",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "zoTnz",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Line stroke: $chart-sequential/seq-500. Area gradient: seq-300 to seq-100 at 0.5 opacity. Track segments: $chart-categorical/color-03 (Cliff), color-01 (Vesting), color-05 (Hold). Event markers: color-04 (Exercise), color-02 (Sale). Selection line and dot: $chart-sequential/seq-500 with white stroke on dot. Tooltip uses ChartTooltip component tokens for background, border, and shadow. Monetary value in tooltip uses MoneyText; phase and event text do not use MoneyText. Labels: $colors-text-meta with $typo-primary-2xs-regular. Grid: $colors-borders-light. Axis: $colors-borders-dark."
                    }
                  }
                },
                {
                  "id": "dg0Q8",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Resize behavior",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "k11vTG",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Card fills available width. PlotArea uses fill_container. The timeline track uses fill_container with fixed-width Cliff and Hold segments; Vesting segment fills remaining space. Compact variant reduces plot height to 150px and Y-axis tick count."
                    }
                  }
                },
                {
                  "id": "vwQHM",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Accessibility",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "QAdAz",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "All text labels use $colors-text-meta on $colors-background-surface — standard WCAG AA contrast. Event markers use both dashed lines AND text labels, so color is never the sole identifier. Phase segments in the timeline track are labeled with text below. Grid lines and axis provide spatial reference."
                    }
                  }
                },
                {
                  "id": "sDL5l",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Implementation note",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "wc1QC",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Event marker dashed lines use repeated 2×6px rectangle segments with gap:4 in a vertical clipped frame, matching the ThresholdLine pattern rotated vertically. Dynamic event positioning, hover states, scrubber interaction, and real tooltip display/focus behavior are implementation concerns."
                    }
                  }
                }
              ]
            }
          ]
