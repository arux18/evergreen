                },
                {
                  "type": "text",
                  "id": "D9ZaF",
                  "name": "Docs Subtitle",
                  "fill": "$colors-text-meta",
                  "content": "Media Primitive",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-semibold-font-family",
                  "fontSize": "$typo-primary-sm-semibold-font-size",
                  "fontWeight": "600",
                  "letterSpacing": "$typo-primary-sm-semibold-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "tT7CQ",
                  "name": "Purpose",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nPrimitive for displaying a single image in OpenUI layouts — cards, image blocks, articles, profiles, chat payloads, and other content surfaces.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "Mc9aC",
                  "name": "When to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Hero, card, or inline imagery with controlled ratio\n• Avatars and thumbnails when paired with frame sizing\n• Chat attachments and article figures inside composed layouts",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "E74Lw",
                  "name": "When not to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Galleries, carousels, or multi-image layouts\n• Captions, titles, or actions (compose with Card / Stack)\n• Decorative illustration systems without a single bitmap asset",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "A8MYIg",
                  "name": "Variants",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants / Defaults\n• ratio: auto | 1:1 | 4:3 | 16:9  →  16:9\n• fit: cover | contain  →  cover\n• radius: none | sm | md | lg  →  md\n• state: default | loading | error  →  default",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "P7Iih",
                  "name": "Token usage",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• Radius none/sm/md/lg → corner radius 0 / $spacing-3xs / $spacing-xs / $spacing-sm\n• Default media uses stock imagery for demo only\n• Loading surface $colors-gray-100, skeleton bars $colors-gray-200\n• Error surface $colors-red-50, stroke $colors-borders-error, icon $colors-icons-error",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "A0l812",
                  "name": "Accessibility",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nImplementation should provide meaningful alt text for informative images. Decorative images should allow an empty alt string so assistive technologies can skip them.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                }
              ]
