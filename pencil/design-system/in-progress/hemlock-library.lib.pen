              "width": "fill_container",
              "layout": "vertical",
              "gap": "$spacing-2xl",
              "children": [
                {
                  "type": "frame",
                  "id": "wtEBe",
                  "name": "Demo Row — Account Detail",
                  "width": "fill_container",
                  "gap": "$spacing-2xl",
                  "children": [
                    {
                      "type": "frame",
                      "id": "S8BjWW",
                      "name": "Demo: WF Checking",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "text",
                          "id": "bGvhN",
                          "name": "Label",
