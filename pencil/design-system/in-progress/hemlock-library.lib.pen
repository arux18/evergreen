                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Positive line: $colors-text-deposit, 1.5px stroke. Negative line: $colors-text-error, 1.5px stroke. Neutral line: $colors-text-meta, 1.5px stroke. Endpoint dot: same color as line, 6px (5px compact). Label: $typo-primary-xs-regular, $colors-text-meta. Value: MoneyText variant (positive/negative/muted). Change: DataValueIndicator variant. With-value label: $typo-primary-sm-regular. Compact label: $typo-primary-2xs-regular. Gap: $spacing-2xs (default), $spacing-xs (with-value), $spacing-3xs (compact)."
                    }
                  }
                },
                {
                  "id": "h7XyCU",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Resize behavior",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "FBPsa",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Sparkline area uses fill_container width. The path is the flex child of the clipped sparklineArea, so it scales with the parent width via viewBox mapping. The endpoint dot is absolutely positioned at the path endpoint for the default component width. Label row uses space_between to keep label and change indicator at opposite edges. Value stays left-aligned."
                    }
                  }
                },
                {
                  "id": "XJnLp",
                  "type": "ref",
