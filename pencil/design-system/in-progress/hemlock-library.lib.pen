            {
              "type": "frame",
              "id": "x8oa6",
              "name": "ChartAxisGrid Documentation",
              "width": 640,
              "layout": "vertical",
              "gap": 32,
              "children": [
                {
                  "id": "F2exQg",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "ChartAxisGrid",
                      "fontSize": "$text-size-lg",
                      "fontWeight": "700",
                      "lineHeight": 1.3333
                    }
                  }
                },
                {
                  "id": "XtYrC",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Defines the visual rules for chart axes, grid lines, tick labels, and reference lines. This component serves as a specification reference for consistent chart foundations across all chart organisms."
                    }
                  }
                },
                {
                  "id": "r5HhYq",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "cQNCV",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Reference this component when building or reviewing any chart organism. Use the specified styles for axis lines, grid lines, tick labels, axis titles, and chart padding. For semantic reference lines (goals, benchmarks, limits), use the ThresholdLine component instead of drawing custom lines. Apply horizontal-grid for area and bar charts."
                    }
                  }
                },
                {
                  "id": "Dg00S",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "W1Amh",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "This is a specification reference, not a standalone visual element. Do not insert ChartAxisGrid directly into screens. Use the individual elements (grid lines, axis labels) when composing chart organisms."
                    }
                  }
                },
                {
                  "id": "tIDFl",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Variants",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "type": "frame",
                  "id": "vPDEK",
                  "name": "Variant List",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": "$spacing-sm",
                  "children": [
                    {
                      "type": "frame",
                      "id": "B4pJ6R",
