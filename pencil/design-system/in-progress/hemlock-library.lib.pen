                  "descendants": {
                    "FHA10": {
                      "content": "Line colors meet WCAG 2.1 non-text contrast (≥3:1) against white backgrounds. Orange-500 on white: ~3.2:1. Blue-600 on white: ~4.8:1. Red-600 on white: ~5.6:1. Line style (dashed/dotted/solid) provides additional non-color differentiation. Labels always accompany lines for screen reader context."
                    }
                  }
                },
                {
                  "id": "joNkb",
                  "type": "ref",
                  "ref": "H9ao5i",
