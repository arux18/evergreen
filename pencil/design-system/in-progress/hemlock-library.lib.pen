                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Purpose\nGeneric table row for transaction/activity history. Five columns: date stack (month+day), description (avatar + name), category, account, amount. Bottom divider. Use as foundation for specific transaction table rows.",
                      "lineHeight": "$line-height-sm",
                      "fontFamily": "$font-primary",
                      "fontSize": "$text-size-sm",
                      "fontWeight": "normal"
                    },
