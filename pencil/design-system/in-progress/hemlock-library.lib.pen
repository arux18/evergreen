                    }
                  }
                },
                {
                  "id": "Zi3ih",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A compact inline mini-chart used to show a small trend inside KPI rows, cards, or financial summaries. Displays a label, monetary value (MoneyText), a sparkline trend line with endpoint dot, and a semantic change indicator (DataValueIndicator)."
                    }
                  }
                },
                {
                  "id": "qTJ2Y",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "VnP7F",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for KPI trend previews, portfolio trend summaries, account summary movement, and compact positive/negative/neutral trend visualization. Use inside KpiCard or dashboard summary rows. Use with-value when the monetary amount needs prominence. Use compact in dense dashboards or table cells."
                    }
                  }
                },
                {
                  "id": "V9MsK",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "yZQTK",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for detailed time-series analysis — use AreaChart instead. Do not use when exact data points matter — sparklines show trends, not precise values. Do not use as a standalone chart — pair with a label and value for context."
