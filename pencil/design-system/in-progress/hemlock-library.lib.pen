                  "name": "Purpose",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nFloating-label single-line field for forms and filters. Visual spec mirrors input.tsx: horizontal padding $spacing-sm, floating label (meta → body when raised), value text $colors-text-header, focus ring $colors-borders-focus, error border $colors-red-700 on $colors-red-50, helper/error line under the field.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "cqCo3",
                  "name": "When to use",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Short text, email, search, codes\n• With Label atom above when you need a static row label instead of float",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "t4LurE",
                  "name": "When not",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Multi-line prose (Textarea)\n• Dates or selects (DatePicker / Select)\n• Read-only display (plain text)",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
