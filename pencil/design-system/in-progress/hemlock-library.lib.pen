            {
              "type": "frame",
              "id": "AGfzf",
              "name": "Image Documentation",
              "width": 640,
              "layout": "vertical",
              "gap": "$spacing-lg",
              "children": [
                {
                  "type": "text",
                  "id": "k7x5fF",
                  "name": "Docs Title",
                  "fill": "$sem-text-header",
                  "content": "Image",
                  "lineHeight": "$line-height-xl",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-xl",
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "D9ZaF",
                  "name": "Docs Subtitle",
                  "fill": "$sem-text-meta",
                  "content": "Media Primitive",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "tT7CQ",
                  "name": "Purpose",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nPrimitive for displaying a single image in OpenUI layouts — cards, image blocks, articles, profiles, chat payloads, and other content surfaces.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Mc9aC",
                  "name": "When to use",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Hero, card, or inline imagery with controlled ratio\n• Avatars and thumbnails when paired with frame sizing\n• Chat attachments and article figures inside composed layouts",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "E74Lw",
                  "name": "When not to use",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Galleries, carousels, or multi-image layouts\n• Captions, titles, or actions (compose with Card / Stack)\n• Decorative illustration systems without a single bitmap asset",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "A8MYIg",
                  "name": "Variants",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants / Defaults\n• ratio: auto | 1:1 | 4:3 | 16:9  →  16:9\n• fit: cover | contain  →  cover\n• radius: none | sm | md | lg  →  md\n• state: default | loading | error  →  default",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "P7Iih",
                  "name": "Token usage",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• Radius none/sm/md/lg → corner radius $radius-none / $radius-3xs / $radius-xs / $radius-sm\n• Default media uses stock imagery for demo only\n• Loading surface $colors-gray-100, skeleton bars $colors-gray-200\n• Error surface $colors-red-50, stroke $colors-borders-error, icon $colors-icons-error",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "A0l812",
                  "name": "Accessibility",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nImplementation should provide meaningful alt text for informative images. Decorative images should allow an empty alt string so assistive technologies can skip them.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
