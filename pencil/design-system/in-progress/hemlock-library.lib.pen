                        }
                      }
                    },
                    {
                      "id": "YMZug",
                      "type": "ref",
                      "ref": "i5vQ3i",
                      "width": "fill_container",
                      "descendants": {
                        "FHA10": {
                          "content": "Atom for individual table header column cells. Provides sort state indicators via Lucide icons: neutral sortable (arrow-up-down), active ascending (arrow-up-narrow-wide), active descending (arrow-down-wide-narrow)."
                        }
                      }
                    },
                    {
                      "id": "n9Hvu1",
                      "type": "ref",
                      "ref": "H9ao5i",
                      "descendants": {
                        "nZEDL": {
                          "content": "Variants",
                          "fontWeight": "600"
                        }
                      }
                    },
                    {
                      "id": "W5JcF",
                      "type": "ref",
                      "ref": "i5vQ3i",
                      "width": "fill_container",
                      "descendants": {
                        "FHA10": {
                          "content": "default: Label only, no sort icon. For non-sortable columns.\nsortable: Label + neutral arrow-up-down icon in $colors-text-meta.\nsorted-asc: Label + arrow-up-narrow-wide in $colors-text-header. Active ascending sort.\nsorted-desc: Label + arrow-down-wide-narrow in $colors-text-header. Active descending sort."
                        }
                      }
                    },
                    {
                      "id": "tLurc",
                      "type": "ref",
                      "ref": "H9ao5i",
                      "descendants": {
                        "nZEDL": {
                          "content": "Token usage",
                          "fontWeight": "600"
                        }
                      }
                    },
                    {
                      "id": "VBESb",
                      "type": "ref",
                      "ref": "i5vQ3i",
                      "width": "fill_container",
                      "descendants": {
                        "FHA10": {
                          "content": "Label: $typo-primary-xs-semibold, $colors-text-meta. Icon: 10×10 Lucide, $colors-text-meta (neutral) or $colors-text-header (active). Gap: 4px. No hardcoded colors."
                        }
                      }
                    },
                    {
                      "id": "B1Dyf",
                      "type": "ref",
                      "ref": "H9ao5i",
                      "descendants": {
                        "nZEDL": {
                          "content": "Accessibility",
                          "fontWeight": "600"
                        }
                      }
                    },
                    {
                      "id": "ZH1af",
                      "type": "ref",
                      "ref": "i5vQ3i",
                      "width": "fill_container",
                      "descendants": {
                        "FHA10": {
                          "content": "Active sorted column should expose aria-sort (ascending/descending). Sortable headers should be keyboard accessible. Sort direction should not rely on icon alone — screen readers need aria-sort attribute."
                        }
                      }
                    },
                    {
                      "id": "ADP08",
                      "type": "ref",
                      "ref": "H9ao5i",
                      "descendants": {
                        "nZEDL": {
                          "content": "Implementation note",
                          "fontWeight": "600"
                        }
                      }
                    },
                    {
                      "id": "sZTBC",
                      "type": "ref",
                      "ref": "i5vQ3i",
                      "width": "fill_container",
                      "descendants": {
                        "FHA10": {
                          "content": "Real sort interaction, column click handlers, active state toggling, and data reordering are implementation-level concerns. The design shows static sort state indicators."
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
