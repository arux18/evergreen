                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use when hovering or focusing a chart data point. Use single-series for AreaChart and simple line charts. Use multi-series for AreaChartMultiSeries and grouped comparisons. Use with-total for financial summaries showing a computed row (e.g. excess return). Use compact for dense dashboards or small chart contexts."
                    }
                  }
                },
                {
                  "id": "VTYym",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
