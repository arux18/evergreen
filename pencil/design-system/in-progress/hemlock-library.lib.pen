                {
                  "type": "text",
                  "id": "X2CYz",
                  "name": "Purpose",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nFloating-label single-line field for forms and filters. Visual spec mirrors input.tsx: horizontal padding $spacing-sm, floating label (meta → body when raised), value text $colors-text-header, focus ring $colors-borders-focus, error border $colors-red-700 on $colors-red-50, helper/error line under the field.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "cqCo3",
                  "name": "When to use",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Short text, email, search, codes\n• With Label atom above when you need a static row label instead of float",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t4LurE",
                  "name": "When not",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Multi-line prose (Textarea)\n• Dates or selects (DatePicker / Select)\n• Read-only display (plain text)",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "y1p61E",
                  "name": "Variants",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants / states (static)\ndefault · filled · focus · no-label · disabled · error · error + icon · trailing icon",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "asnxw",
                  "name": "Tokens",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• Field text: typo-primary-base-regular + $colors-text-header\n• Floating label idle: $colors-text-meta; raised / focused: typo-primary-xs-semibold + $colors-text-body\n• Placeholder tone: $colors-text-placeholder\n• Border default: $colors-borders-dark; hover (implementation): $colors-gray-400\n• Focus outline: $colors-borders-focus (2px)\n• Disabled field: $colors-gray-50 fill, $colors-gray-300 stroke, $colors-text-disabled\n• Error field: $colors-red-700 stroke, $colors-red-50 fill; icon $colors-red-400\n• Error caption: typo-primary-sm-semibold + $colors-text-error; spacing below $spacing-3xs\n• Horizontal padding: $spacing-sm; radii: $radius-3xs\n• Transitions: focus/hover = $duration-fast + $easing-standard",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "uJtkY",
                  "name": "A11y",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Accessibility\nImplementation should pair label and control with id/htmlFor (or aria-label). Surface errors with aria-invalid and aria-describedby to the error text. Disabled inputs must omit pointer events and use disabled styling tokens.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                }
              ]
