                {
                  "id": "ZMHNo",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A reusable semantic reference line for charts. Displays a colored horizontal line with a descriptive label. Each variant uses a distinct line style (dashed, dotted, solid) and semantic color to differentiate goals, benchmarks, and limits."
                    }
                  }
                },
                {
                  "id": "r4EBtL",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "i3Qck3",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use inside chart organisms to indicate target values, benchmark comparisons, or limit thresholds. Use goal for aspirational targets (e.g. savings goal). Use benchmark for comparison baselines (e.g. market index). Use limit for hard boundaries (e.g. budget cap, risk threshold)."
                    }
                  }
                },
                {
                  "id": "l5kKQT",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "X27U1",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for axis lines or grid lines — those belong in ChartAxisGrid. Do not use as decorative dividers — use Separator instead."
                    }
                  }
                },
