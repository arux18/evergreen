                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A single-series area chart organism showing a data trend over time. Built on Card with CardHeader, a chart body containing y-axis labels and a clipped plot area, x-axis labels, and an optional ChartTooltip overlay. The area fill and line stroke are separate paths for clean rendering."
                    }
                  }
                },
                {
                  "id": "Iu79j",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
