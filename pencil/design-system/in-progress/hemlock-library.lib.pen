                  "name": "Purpose",
                  "descendants": {
                    "FHA10": {
                      "content": "A horizontally navigable container for browsing a small set of related content or media items. Previous/next controls are 32×32 white circular buttons with shadow-lg, positioned on the left and right edges of the slide viewport, partially overlapping the image area. PaginationDot instances below the viewport indicate slide position. This is a visual organism only — real slide state, autoplay, gestures, and lightbox behavior are out of scope."
                    }
                  }
                },
                {
                  "id": "dXOw7",
                  "type": "ref",
                  "ref": "H9ao5i",
