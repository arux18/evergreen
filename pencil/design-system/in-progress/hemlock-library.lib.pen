                {
                  "type": "text",
                  "id": "kGXo2",
                  "name": "Purpose",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nGeneric header content for detail drawers and panels. Provides an Avatar slot alongside a title (and optional eyebrow text). Injected into ModalDrawer's headerSlot to identify the entity being viewed.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DXfKR",
                  "name": "When to use",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Detail drawer headers in ModalDrawer\n• Any panel header needing an avatar/icon + title\n• Entity identification headers (accounts, transactions, holdings, etc.)",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "WWQLJ",
                  "name": "When not to use",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• Page-level headers — use page header patterns\n• Card headers — use CardHeader\n• Navigation headers — use nav bar components",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "jA56b",
                  "name": "Variants",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants\n• default — Avatar (36×36) + single-line Title. For simple entity headers.\n• with-eyebrow — Avatar (36×36) + Eyebrow text (small, meta color) + Title. For headers needing a secondary label above the title (e.g. ticker symbol, category).",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "B1sbM",
                  "name": "Composition",
                  "fill": "$sem-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Composition\n• Frame: horizontal, gap 12, center-aligned, width 400\n• Avatar: component/Avatar ref, overridden to 36×36. Replace with fallback or icon variant per instance.\n• Title area:\n  — default: single text, $font-family-secondary, $typo-primary-xl-semibold\n  — with-eyebrow: vertical frame with eyebrow ($colors-text-meta, 11px) + title\n\nNote: DetailHeader does not include a close button. The close button is provided by ModalDrawer's Header frame.",
                  "lineHeight": "$line-height-sm",
                  "fontFamily": "$font-primary",
                  "fontSize": "$text-size-sm",
                  "fontWeight": "normal"
                }
              ]
            }
