                  }
                },
                {
                  "id": "pAWmq",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "A projected vs actual chart organism comparing realized performance against a future projection. Built on Card with CardHeader, a chart body containing y-axis labels and a clipped plot area with two line paths (solid actual, dashed projected), a vertical today marker, an active dot, and an inline legend row."
                    }
                  }
                },
                {
                  "id": "q6v6SF",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "LwA5V",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for performance tracking: portfolio growth vs plan, savings trajectory vs goal, revenue vs forecast. The solid/dashed line distinction clearly separates known data from projections. Use with-today-marker to add a labeled vertical divider. Use compact in dense dashboards. Use no-card when embedding inside another container."
                    }
                  }
                },
                {
                  "id": "NALZ1",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "When not to use",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "jf6rJ",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Do not use for comparing multiple actual series — use AreaChartMultiSeries. Do not use when there is no projection component — use AreaChart. Do not use for categorical comparisons — use BarChart or BenchmarkComparisonChart."
                    }
                  }
                },
                {
                  "id": "O2bSY6",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Variants",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "WxswD",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "default: Solid actual line + dashed projected line + vertical today marker + active dot.\nwith-today-marker: Same as default plus a 'Today' text label below the marker.\nwith-tooltip: Default with ChartTooltip/with-total positioned near the selected point. Shows Actual and Projected values in value rows with MoneyText. Delta in the total row using MoneyText/negative (underperformance) or MoneyText/positive (outperformance). Markers match series colors.\ncompact: 360px width, 140px plot height.\nno-card: Same chart structure without Card wrapper."
                    }
                  }
                },
                {
                  "id": "wLLOt",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Composition",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "U3PQs",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "ProjectedVsActualChart = Card + CardHeader/description + chartBody (chartRow: yAxis + plotArea) + xAxis + legendRow + optional ChartTooltip. PlotArea (layout: vertical, clip: true) contains grid lines (absolute), actual line path (absolute, solid stroke $chart-categorical/color-01), projected dashed line as individual dash path nodes (absolute, stroke $colors-text-meta), today marker as individual dash path nodes (absolute, stroke $colors-text-disabled), and active dot ellipse. Legend row has solid line marker for Actual and 3-segment dashed marker for Projected. With-tooltip adds ChartTooltip/with-total (layoutPosition: absolute) inside chartBody showing actual/projected values and delta for the selected point."
                    }
                  }
                },
                {
                  "id": "OKKW8",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Token usage",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "e7qCd",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Actual line: $chart-categorical/color-01, 2px stroke, single path. Projected line: $colors-text-meta, 2px stroke, rendered as individual dash path nodes. Today marker: $colors-text-disabled, 1px stroke, rendered as individual dash path nodes. Active dot: $chart-categorical/color-01, 8px ellipse. Grid: $colors-borders-light. Axis: $colors-borders-dark. Labels: $typo-primary-2xs-regular, $colors-text-meta. Legend text: $typo-primary-sm-regular, $colors-text-body. Tooltip (with-tooltip): ChartTooltip tokens — $colors-background-surface fill, $colors-borders-light stroke, outer shadow. Values use MoneyText; delta uses MoneyText/negative or MoneyText/positive."
                    }
                  }
                },
                {
