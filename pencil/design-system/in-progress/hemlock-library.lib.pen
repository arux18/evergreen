                                  "ref": "i5vQ3i",
                                  "name": "bodyText1",
                                  "width": "fill_container",
                                  "descendants": {
                                    "FHA10": {
                                      "content": "Sections divide the conversation into logical parts. They can contain text, lists, callouts, or collapsible content. When designing complex AI responses, breaking the output into well-defined sections improves both readability and comprehension.",
                                      "fontFamily": "$font-primary",
                                      "fontSize": "$text-size-sm",
                                      "lineHeight": "$line-height-sm"
                                    }
                                  }
                                },
                                {
                                  "id": "Q40uc",
                                  "type": "ref",
                                  "ref": "i5vQ3i",
                                  "name": "bodyText2",
                                  "width": "fill_container",
                                  "descendants": {
                                    "FHA10": {
                                      "content": "Use sections to separate topics, steps, or categories in a long response. Each section should focus on a single concept or theme, making it easier for users to scan, reference, and act on specific parts of the content.",
                                      "fontFamily": "$font-primary",
                                      "fontSize": "$text-size-sm",
                                      "lineHeight": "$line-height-sm"
                                    }
                                  }
                                },
                                {
                                  "id": "uiqJd",
                                  "type": "ref",
                                  "ref": "i5vQ3i",
                                  "name": "bodyText3",
                                  "width": "fill_container",
                                  "descendants": {
                                    "FHA10": {
                                      "content": "Combine sections with other patterns like callouts for emphasis, lists for structured data, and accordions for optional detail. This layered approach creates a rich, navigable document structure within a single response.",
                                      "fontFamily": "$font-primary",
                                      "fontSize": "$text-size-sm",
                                      "lineHeight": "$line-height-sm"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
