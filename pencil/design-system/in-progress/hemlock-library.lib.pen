                  "descendants": {
                    "FHA10": {
                      "content": "Displays selected chart values for one or more data series. Appears as an overlay anchored near a selected data point on the chart. Shows a header (date or period), series color markers, labels, and formatted values."
                    }
                  }
                },
                {
                  "id": "T5ixn",
                  "type": "ref",
                  "ref": "H9ao5i",
