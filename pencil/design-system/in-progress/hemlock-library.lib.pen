                },
                {
                  "type": "text",
                  "id": "FB7Iu",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Purpose\nA low-level divider primitive for visually separating content horizontally or vertically. Used by future components like Card, FormField, Accordion, PageLayout, lists, and chat blocks.",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "Rar82",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When to use\n• Between groups of related content in a vertical stack\n• Between list items, form sections, or sidebar groups\n• To reinforce visual hierarchy without adding a container",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "j5eyvr",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When NOT to use\n• As a border on a container (use stroke/border tokens directly)\n• For pure decoration with no content-separation purpose\n• When whitespace alone provides sufficient separation",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "h4E3Ca",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Variants / Defaults\n• orientation: horizontal | vertical  →  horizontal\n• tone: subtle | default  →  subtle\n• spacing: none(0) | sm(16) | md(24) | lg(32)  →  md",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
                  "letterSpacing": "$typo-primary-sm-regular-letter-spacing"
                },
                {
                  "type": "text",
                  "id": "lAwCe",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Token usage\n• tone.subtle = $colors-borders-light (gray-100)\n• tone.default = $colors-borders-dark (gray-200)\n• spacing.none = 0\n• spacing.sm = $spacing-sm (16px)\n• spacing.md = $spacing-md (24px)\n• spacing.lg = $spacing-lg (32px)",
                  "lineHeight": 1.4286,
                  "fontFamily": "$typo-primary-sm-regular-font-family",
                  "fontSize": "$typo-primary-sm-regular-font-size",
                  "fontWeight": "normal",
