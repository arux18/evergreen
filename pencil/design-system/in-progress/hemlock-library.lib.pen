                        },
                        {
                          "type": "text",
                          "id": "KjgPS",
                          "fill": "$sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Chart content without Card wrapper. 480px width. Use when chart is embedded inside another Card or container.",
                          "fontFamily": "$font-primary",
                          "fontSize": "$text-size-2xs",
