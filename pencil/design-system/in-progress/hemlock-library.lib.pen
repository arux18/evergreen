                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "JbjcV",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": "$spacing-3xs",
                      "children": [
                        {
                          "type": "text",
                          "id": "rMPxr",
                          "fill": "$sem-text-header",
                          "content": "with-legend",
                          "fontFamily": "$font-primary",
                          "fontSize": "$text-size-sm",
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "HlEJ1",
                          "fill": "$sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Default with legend visible. Legend uses ChartLegend/inline-top.",
                          "fontFamily": "$font-primary",
                          "fontSize": "$text-size-2xs",
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "doWA6",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": "$spacing-3xs",
                      "children": [
                        {
                          "type": "text",
                          "id": "LEm7z",
                          "fill": "$sem-text-header",
                          "content": "compact",
                          "fontFamily": "$font-primary",
                          "fontSize": "$text-size-sm",
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "SnJkf",
                          "fill": "$sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Dense Card/dense wrapper, 360px width, 140px chart height. Uses ChartLegend/compact.",
                          "fontFamily": "$font-primary",
                          "fontSize": "$text-size-2xs",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "HvNXG",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Composition",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "mqHJN",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "AreaChartMultiSeries = Card + CardHeader/description + ChartLegend (inline-top) + chartBody (chartRow: yAxis + plotArea + xAxis). PlotArea (layout: vertical, clip: true) has the bottom area fill as its flex child for responsive scaling. Other area fills and line strokes are absolutely positioned on top. The scrubber is a vertical dashed segment frame (2px wide, $colors-text-disabled, 6px segments / 4px gap, clipped) positioned absolutely in plotArea, with per-series dots. ChartTooltip/multi-series instance sits outside the clipped plotArea — it is a sibling in chartRow with layoutPosition: absolute, so it is never clipped. Tooltip is positioned to the left of the scrubber when the selected point is near the right edge, keeping it within the card bounds. Series are painted in reverse order so the primary series (color-01) renders on top."
                    }
                  }
                },
                {
                  "id": "Z4JHLq",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Token usage",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "ZqHo8",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Series 1: $chart-categorical/color-01 (line 2px, area 20% opacity). Series 2: $chart-categorical/color-02 (line 1.5px, area 20%). Series 3: $chart-categorical/color-03 (line 1.5px, area 20%). Grid: $colors-borders-light. Axis: $colors-borders-dark. Dots: 8px ellipse, same series color. Scrubber: vertical dashed segments, $colors-text-disabled, 2px wide, 6px segments / 4px gap. Legend: ChartLegend tokens. Tooltip: ChartTooltip/multi-series tokens."
                    }
                  }
                },
                {
                  "id": "gztHO",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Resize behavior",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "nfEzr",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Card fills available width via fill_container. chartBody, chartRow, and plotArea all use fill_container. The bottom area fill is the flex child of plotArea (layout: vertical), so it scales with the container. Other fills and line strokes use fixed widths matching the default component size. Grid lines extend to 5000px and are clipped. Axis labels distribute via space_between. ChartTooltip is outside the clipped plotArea (absolute positioned in chartRow) but stays inside the card bounds — it is placed to the left of the scrubber when the selected point is near the right edge. Legend wraps when width is constrained."
                    }
                  }
                },
                {
                  "id": "V3qz6",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Accessibility",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "SHtty",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "ChartLegend is required — it maps colors to series names. Do not rely on color alone. Tooltip shows all series values at the selected point. Categorical chart colors maintain 3:1 contrast against white. Provide text summary of trends. Keyboard/focus access to tooltip values is an implementation concern."
                    }
                  }
                },
                {
                  "id": "LNbBF",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
                      "content": "Implementation note",
                      "fontWeight": "600"
                    }
                  }
                },
                {
                  "id": "O0AzAk",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "This is a visual chart component. Real chart rendering, data binding, tooltip positioning, series interactivity, responsive scaling, and animation are implementation concerns."
                    }
                  }
                }
              ]
            }
          ]
