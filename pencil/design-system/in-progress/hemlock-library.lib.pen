                {
                  "id": "T4cQN",
                  "type": "ref",
                  "ref": "i5vQ3i",
                  "width": "fill_container",
                  "descendants": {
                    "FHA10": {
                      "content": "Use for single-metric time-series visualizations: revenue trends, portfolio value, account balance over time. The filled area emphasizes magnitude. Use with-tooltip to show precise values on interaction. Use with-reference-line to indicate targets or thresholds. Use compact in dense dashboards. Use no-card when embedding inside another container."
                    }
                  }
                },
                {
                  "id": "PfHIO",
                  "type": "ref",
                  "ref": "H9ao5i",
                  "descendants": {
                    "nZEDL": {
