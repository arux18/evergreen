          ],
          "children": [
            {
              "type": "text",
              "id": "oZTs5",
              "name": "title",
              "fill": "$y:sem-text-header",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Your investments have seen recent success.",
              "lineHeight": "$y:line-height-xs",
              "fontFamily": "Noto Serif",
              "fontSize": "$y:text-size-2xl"
            },
            {
              "type": "text",
              "id": "zADKN",
              "name": "intro",
              "fill": "$y:prim-navylight-700",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Across your linked investment accounts, money in has far outpaced money out this year. Here's the full picture of what's flowing through your portfolio.",
              "lineHeight": "$y:line-height-base",
              "fontFamily": "Noto Serif",
              "fontSize": "$y:text-size-lg",
              "fontWeight": "300"
            },
            {
              "type": "text",
              "id": "C1hR2",
              "name": "body1",
              "fill": "$y:prim-navylight-700",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Your accounts brought in $248,857 over this period — contributions, dividends, and transfers in — while $69,096 flowed out through withdrawals, fees, and transfers. That leaves a net flow of +$179,762 staying invested and working for you.",
              "lineHeight": "$y:line-height-base",
              "fontFamily": "Gothic A1",
              "fontSize": "$y:text-size-base"
            },
            {
              "type": "text",
              "id": "kYYyR",
              "name": "body2",
              "fill": "$y:prim-navylight-700",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The charts below break down where each dollar came from and where it went. A consistently positive net flow like this means your portfolio is compounding from fresh contributions on top of market growth. It's worth watching the expense slices over time to keep fees a small share of the total.",
              "lineHeight": "$y:line-height-base",
              "fontFamily": "Gothic A1",
              "fontSize": "$y:text-size-base"
            },
            {
              "type": "rectangle",
              "id": "mvoqY",
              "name": "tableImage",
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "New-Library-Editorial-Inspired-Q4-assets/donut-charts-midnight.png",
                "mode": "cover"
              },
              "width": "fill_container",
              "height": 547
            },
            {
              "type": "text",
              "id": "ioFku",
              "name": "body2",
