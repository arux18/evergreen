                  "gap": "$y:spacing-md",
                  "children": [
                    {
                      "type": "text",
                      "id": "V9ap1",
                      "name": "introText",
                      "fill": "$y:sem-text-strong",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Which retirement accounts are right for you?",
                      "lineHeight": "$y:line-height-xs",
                      "fontFamily": "$y:font-secondary",
                      "fontSize": "$y:spacing-xl"
                    },
                    {
                      "type": "text",
                      "id": "HcY3b",
                      "name": "introText",
                      "fill": "$y:sem-text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Retirement accounts right for you include employer-sponsored plans like a 401(k), 403(b), and more, as well as a traditional IRA, Roth IRA, and more.",
                      "lineHeight": "$y:line-height-base",
                      "fontFamily": "$y:font-secondary",
                      "fontSize": "$y:text-size-lg"
                    }
                  ]
                },
                {
                  "type": "rectangle",
                  "id": "w4Fcu",
                  "metadata": {
                    "type": "unsplash",
                    "username": "onurbdias",
                    "link": "https://unsplash.com/@onurbdias",
                    "author": "Bruno Dias"
                  },
                  "fill": {
                    "type": "image",
                    "enabled": true,
                    "url": "https://images.unsplash.com/photo-1781791967670-680eaca7de02?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3OTA4ODI0MTl8&ixlib=rb-4.1.0&q=80&w=1080",
                    "mode": "cover"
                  },
                  "width": 366,
                  "height": 219
                }
              ]
            },
            {
              "type": "text",
              "id": "bxD3c",
              "name": "introText",
              "fill": "$y:sem-text-strong",
              "textGrowth": "fixed-width",
              "width": 670,
              "content": "Retirement accounts fall into two groups: workplace plans your employer sponsors, and individual accounts you open yourself. Within each group, the real choice is about when you pay tax.",
              "lineHeight": "$y:line-height-base",
              "fontFamily": "Gothic A1",
              "fontSize": "$y:text-size-lg"
            },
            {
              "type": "text",
              "id": "F5vKX",
              "name": "introText",
              "fill": "$y:sem-text-strong",
              "textGrowth": "fixed-width",
              "width": 670,
              "content": "You can pay it now and take qualified withdrawals tax-free later (Roth), or deduct contributions now and pay ordinary income tax on withdrawals later (traditional, or pre-tax). The account's label matters less than that tax timing and how much you can put in.",
              "lineHeight": "$y:line-height-base",
              "fontFamily": "Gothic A1",
              "fontSize": "$y:text-size-lg"
            },
