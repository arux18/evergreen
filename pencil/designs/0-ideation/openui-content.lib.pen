{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "tcSm01",
      "x": 0,
      "y": 0,
      "name": "TextContent / small",
      "reusable": true,
      "width": 360,
      "layout": "vertical",
      "children": [
        {
          "type": "text",
          "id": "tcSmTx",
          "name": "Content",
          "fill": "$colors-text-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "As of market close · May 18, 2026",
          "lineHeight": 1.5,
          "fontFamily": "$typo-primary-sm-regular-font-family",
          "fontSize": "$typo-primary-sm-regular-font-size",
          "fontWeight": "$typo-primary-sm-regular-font-weight"
        }
      ]
    },
    {
      "type": "frame",
      "id": "tcMd01",
      "x": 380,
      "y": 0,
      "name": "TextContent / medium",
      "reusable": true,
      "width": 360,
      "layout": "vertical",
      "children": [
        {
          "type": "text",
          "id": "tcMdTx",
          "name": "Content",
          "fill": "$colors-text-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Your total portfolio value is $847,213, up 12.4% year to date. Equities lead gains while bond allocations remain stable.",
          "lineHeight": 1.5,
          "fontFamily": "$typo-primary-base-regular-font-family",
          "fontSize": "$typo-primary-base-regular-font-size",
          "fontWeight": "$typo-primary-base-regular-font-weight"
        }
      ]
    },
    {
      "type": "frame",
      "id": "tcLg01",
      "x": 760,
      "y": 0,
      "name": "TextContent / large",
      "reusable": true,
      "width": 360,
      "layout": "vertical",
      "children": [
        {
          "type": "text",
          "id": "tcLgTx",
          "name": "Content",
          "fill": "$colors-text-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Review your allocation strategy and rebalance targets for the upcoming quarter.",
          "lineHeight": 1.5,
          "fontFamily": "$typo-primary-md-regular-font-family",
          "fontSize": "$typo-primary-md-regular-font-size",
          "fontWeight": "$typo-primary-md-regular-font-weight"
        }
      ]
    },
    {
      "type": "frame",
      "id": "tcLh01",
      "x": 1140,
      "y": 0,
      "name": "TextContent / large-heavy",
      "reusable": true,
      "width": 360,
      "layout": "vertical",
      "children": [
        {
          "type": "text",
          "id": "tcLhTx",
          "name": "Content",
          "fill": "$colors-text-header",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Portfolio overview",
          "lineHeight": 1.3,
          "fontFamily": "$typo-primary-lg-semibold-font-family",
          "fontSize": "$typo-primary-lg-semibold-font-size",
          "fontWeight": "$typo-primary-lg-semibold-font-weight"
        }
      ]
    },
    {
      "type": "frame",
      "id": "mdRnd01",
      "x": 0,
      "y": 120,
      "name": "MarkDownRenderer",
      "reusable": true,
      "width": 480,
      "layout": "vertical",
      "gap": "$spacing-sm",
      "children": [
        {
          "type": "text",
          "id": "mdHdg1",
          "name": "Heading",
          "fill": "$colors-text-header",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Portfolio overview",
          "lineHeight": 1.3,
          "fontFamily": "$typo-primary-base-semibold-font-family",
          "fontSize": "$typo-primary-base-semibold-font-size",
          "fontWeight": "$typo-primary-base-semibold-font-weight"
        },
        {
          "type": "frame",
          "id": "mdPara1",
          "name": "Paragraph",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$spacing-3xs",
          "children": [
            {
              "type": "text",
              "id": "mdPrTx",
              "name": "Body",
              "fill": "$colors-text-body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Your total portfolio value is $847,213, up 12.4% year to date. Equities lead gains while bond allocations remain stable.",
              "lineHeight": 1.5,
              "fontFamily": "$typo-primary-base-regular-font-family",
              "fontSize": "$typo-primary-base-regular-font-size",
              "fontWeight": "$typo-primary-base-regular-font-weight"
            },
            {
              "type": "frame",
              "id": "mdBold1",
              "name": "BoldInline",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "mdBlP1",
                  "name": "Prefix",
                  "fill": "$colors-text-body",
                  "content": "Year-to-date return: ",
                  "lineHeight": 1.5,
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                },
                {
                  "type": "text",
                  "id": "mdBlTx",
                  "name": "Bold",
                  "fill": "$colors-text-header",
                  "content": "+12.4%",
                  "lineHeight": 1.5,
                  "fontFamily": "$typo-primary-base-semibold-font-family",
                  "fontSize": "$typo-primary-base-semibold-font-size",
                  "fontWeight": "$typo-primary-base-semibold-font-weight"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "mdList1",
          "name": "List",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$spacing-3xs",
          "padding": [
            0,
            0,
            0,
            "$spacing-sm"
          ],
          "children": [
            {
              "type": "frame",
              "id": "mdLi01",
              "name": "Item 1",
              "width": "fill_container",
              "gap": "$spacing-2xs",
              "children": [
                {
                  "type": "text",
                  "id": "mdBu01",
                  "name": "Bullet",
                  "fill": "$colors-text-body",
                  "content": "•",
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                },
                {
                  "type": "text",
                  "id": "mdTx01",
                  "name": "Text",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "US equities returned 14.2% year to date",
                  "lineHeight": 1.5,
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                }
              ]
            },
            {
              "type": "frame",
              "id": "mdLi02",
              "name": "Item 2",
              "width": "fill_container",
              "gap": "$spacing-2xs",
              "children": [
                {
                  "type": "text",
                  "id": "mdBu02",
                  "name": "Bullet",
                  "fill": "$colors-text-body",
                  "content": "•",
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                },
                {
                  "type": "text",
                  "id": "mdTx02",
                  "name": "Text",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Fixed income held steady at 4.1% yield",
                  "lineHeight": 1.5,
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                }
              ]
            },
            {
              "type": "frame",
              "id": "mdLi03",
              "name": "Item 3",
              "width": "fill_container",
              "gap": "$spacing-2xs",
              "children": [
                {
                  "type": "text",
                  "id": "mdBu03",
                  "name": "Bullet",
                  "fill": "$colors-text-body",
                  "content": "•",
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                },
                {
                  "type": "text",
                  "id": "mdTx03",
                  "name": "Text",
                  "fill": "$colors-text-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Cash reserves cover 6 months of expenses",
                  "lineHeight": 1.5,
                  "fontFamily": "$typo-primary-base-regular-font-family",
                  "fontSize": "$typo-primary-base-regular-font-size",
                  "fontWeight": "$typo-primary-base-regular-font-weight"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "mdLink1",
          "name": "Link",
          "fill": "$colors-text-action",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Learn more about your allocation",
          "lineHeight": 1.5,
          "fontFamily": "$typo-primary-base-regular-font-family",
          "fontSize": "$typo-primary-base-regular-font-size",
          "fontWeight": "$typo-primary-base-regular-font-weight"
        }
      ]
    }
  ],
  "variables": {
    "colors-text-action": {
      "type": "color",
      "value": "#3a6af8"
    },
    "colors-text-body": {
      "type": "color",
      "value": "#403D3A"
    },
    "colors-text-header": {
      "type": "color",
      "value": "#0e0e0e"
    },
    "spacing-2xs": {
      "type": "number",
      "value": 8
    },
    "spacing-3xs": {
      "type": "number",
      "value": 4
    },
    "spacing-sm": {
      "type": "number",
      "value": 16
    },
    "typo-primary-base-regular-font-family": {
      "type": "string",
      "value": "Heebo"
    },
    "typo-primary-base-regular-font-size": {
      "type": "number",
      "value": 16
    },
    "typo-primary-base-regular-font-weight": {
      "type": "string",
      "value": "normal"
    },
    "typo-primary-base-semibold-font-family": {
      "type": "string",
      "value": "Heebo"
    },
    "typo-primary-base-semibold-font-size": {
      "type": "number",
      "value": 16
    },
    "typo-primary-base-semibold-font-weight": {
      "type": "string",
      "value": "600"
    },
    "typo-primary-lg-semibold-font-family": {
      "type": "string",
      "value": "Heebo"
    },
    "typo-primary-lg-semibold-font-size": {
      "type": "number",
      "value": 20
    },
    "typo-primary-lg-semibold-font-weight": {
      "type": "string",
      "value": "600"
    },
    "typo-primary-md-regular-font-family": {
      "type": "string",
      "value": "Heebo"
    },
    "typo-primary-md-regular-font-size": {
      "type": "number",
      "value": 18
    },
    "typo-primary-md-regular-font-weight": {
      "type": "string",
      "value": "normal"
    },
    "typo-primary-sm-regular-font-family": {
      "type": "string",
      "value": "Heebo"
    },
    "typo-primary-sm-regular-font-size": {
      "type": "number",
      "value": 14
    },
    "typo-primary-sm-regular-font-weight": {
      "type": "string",
      "value": "normal"
    }
  }
}