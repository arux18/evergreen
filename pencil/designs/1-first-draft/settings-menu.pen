                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 24,
                  "padding": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "d4gXo",
                      "name": "text",
                      "fill": "$chat.text.secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What do my holdings look like this month?",
                      "fontFamily": "Heebo",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "TSJKo",
                      "name": "rowButtons",
                      "width": "fill_container",
                      "gap": 8,
                      "justifyContent": "end",
                      "children": [
                        {
                          "type": "frame",
                          "id": "k6Fn4N",
                          "name": "Chat / Voice Button / Default",
                          "context": "Voice input button (default state). 34×34 pill, transparent background with border. Tapping starts speech-to-text recording via Cartesia. Place in input field secondary buttons area. States: default, hover, pressed, active (recording).",
                          "width": 34,
                          "height": 34,
                          "fill": "#00000000",
                          "cornerRadius": 9999,
                          "stroke": "$chat.chip.border",
                          "strokeWidth": 1,
                          "strokeAlignment": "inner",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "jaWBe",
                              "name": "icon",
                              "width": 16,
                              "height": 16,
                              "icon": "mic",
                              "library": "lucide",
                              "fill": "$chat.icon"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MUm36",
                          "name": "Chat / Send Button / Default",
                          "context": "Primary send button for submitting chat messages. 34×34 pill, dark fill ($chat.send.bg) with white arrow-up icon. Place at the right end of the input field button row. States: default, hover, pressed, disabled.",
                          "width": 34,
                          "height": 34,
                          "fill": "$chat.send.bg",
                          "cornerRadius": 9999,
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "xJ3QE",
                              "name": "sendIcon",
                              "width": 20,
                              "height": 20,
                              "icon": "arrow-up",
                              "library": "lucide",
                              "fill": "$chat.send.icon"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
