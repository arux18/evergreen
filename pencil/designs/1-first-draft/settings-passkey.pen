                                  "type": "text",
                                  "id": "GdZFS",
                                  "name": "What are passkeys?",
                                  "fill": "#0e0e0eff",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "What are passkeys?",
                                  "lineHeight": 1.4285714285714286,
                                  "textAlignVertical": "middle",
                                  "fontFamily": "Open Sans",
                                  "fontSize": 14,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "qp7sQ",
                                  "name": "Passkeys are highly secure encrypted digital keys created using your fingerprint, facial recognition, or screen lock that replace the traditional password login method.",
                                  "fill": "#575b58ff",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Passkeys are highly secure encrypted digital keys created using your fingerprint, facial recognition, or screen lock that replace the traditional password login method.",
