                          "type": "text",
                          "id": "VoJSO",
                          "name": "itemTitle",
                          "fill": "$y:sem-text-header",
                          "content": "Where are passkeys saved?",
                          "fontFamily": "$y:font-primary",
                          "fontSize": "$y:text-size-sm",
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "i2dvzm",
                          "name": "itemDesc",
                          "fill": "$y:sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Passkeys are saved to your device or password manager, so you can sign in from your other devices too.",
                          "fontFamily": "$y:font-primary",
                          "fontSize": "$y:text-size-sm",
                          "fontWeight": "normal"
                        }
