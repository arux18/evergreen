                          "name": "itemDesc",
                          "fill": "$y:sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Passkeys are secure encrypted digital keys that use your fingerprint, face, or screen lock to sign you in, replacing traditional passwords.",
