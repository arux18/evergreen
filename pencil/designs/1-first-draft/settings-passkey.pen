                        {
                          "type": "text",
                          "id": "n98XRP",
                          "name": "itemTitle",
                          "fill": "$y:sem-text-header",
                          "content": "What are passkeys?",
                          "fontFamily": "$y:font-primary",
                          "fontSize": "$y:text-size-sm",
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "MAhGC",
                          "name": "itemDesc",
                          "fill": "$y:sem-text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Passkeys are secure encrypted digital keys that use your fingerprint, face, or screen lock to sign you in, replacing traditional passwords.",
                          "fontFamily": "$y:font-primary",
                          "fontSize": "$y:text-size-sm",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
