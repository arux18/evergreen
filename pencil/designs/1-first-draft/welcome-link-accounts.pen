{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "wlaPanel",
      "x": 0,
      "y": 0,
      "name": "Welcome — Link Accounts (Center Panel)",
      "clip": true,
      "width": 912,
      "height": 900,
      "fill": "$G:colors-background-surface",
      "layout": "vertical",
      "justifyContent": "center",
      "alignItems": "center",
      "padding": [56, 48, 24, 48],
      "children": [
        {
          "type": "frame",
          "id": "wlaHero",
          "name": "Hero",
          "width": 600,
          "layout": "vertical",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "wlaEyebrow",
              "name": "Eyebrow",
              "width": "fit_content",
              "fill": "$G:color-blue-100",
              "cornerRadius": "$G:radius-full",
              "padding": [6, 14],
              "layout": "horizontal",
              "alignItems": "center",
              "gap": "$G:spacing-2xs",
              "children": [
                {
                  "type": "frame",
                  "id": "wlaOrb",
                  "name": "Orb",
                  "width": 14,
                  "height": 14,
                  "cornerRadius": "$G:radius-full",
                  "fill": "$G:color-blue-600",
                  "layout": "none"
                },
                {
                  "type": "text",
                  "id": "wlaEyebrowText",
                  "name": "Eyebrow Label",
                  "fill": "$G:color-blue-700",
                  "content": "YOUR PERSONAL AI ADVISOR",
                  "textGrowth": "auto",
                  "letterSpacing": 1,
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-xs-regular-font-size",
                  "fontWeight": "500"
                },
                {
                  "type": "frame",
                  "id": "wlaEyebrowDivider",
                  "name": "Divider",
                  "width": 1,
                  "height": 12,
                  "fill": "$G:color-blue-300",
                  "layout": "none"
                },
                {
                  "type": "text",
                  "id": "wlaBeta",
                  "name": "Beta",
                  "fill": "$G:color-blue-700",
                  "content": "Beta",
                  "textGrowth": "auto",
                  "letterSpacing": 0.5,
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-xs-regular-font-size",
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaHeadlineWrap",
              "name": "Headline Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "alignItems": "center",
              "padding": [26, 0, 0, 0],
              "children": [
                {
                  "type": "text",
                  "id": "wlaHeadline1",
                  "name": "Headline Line 1",
                  "fill": "$G:colors-text-header",
                  "content": "Advice that knows",
                  "textAlign": "center",
                  "textGrowth": "auto",
                  "lineHeight": 1.05,
                  "letterSpacing": -1,
                  "fontFamily": "$G:font-family-secondary",
                  "fontSize": "$G:typo-secondary-4xl-regular-font-size",
                  "fontWeight": "400"
                },
                {
                  "type": "text",
                  "id": "wlaHeadline2",
                  "name": "Headline Line 2",
                  "fill": "$G:colors-text-action",
                  "content": "your money.",
                  "textAlign": "center",
                  "textGrowth": "auto",
                  "lineHeight": 1.05,
                  "letterSpacing": -1,
                  "fontStyle": "italic",
                  "fontFamily": "$G:font-family-secondary",
                  "fontSize": "$G:typo-secondary-4xl-regular-font-size",
                  "fontWeight": "400"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaSubheadWrap",
              "name": "Subhead Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "alignItems": "center",
              "padding": [20, 0, 0, 0],
              "children": [
                {
                  "type": "text",
                  "id": "wlaSubhead",
                  "name": "Subhead",
                  "fill": "$G:colors-text-body",
                  "content": "You've seen what your AI advisor can do. Link your accounts and every answer gets grounded in your full financial picture — your balances, spending, and investments, synced automatically so your advice is always up to date.",
                  "textAlign": "center",
                  "textGrowth": "fixed-width",
                  "width": 468,
                  "lineHeight": 1.55,
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-base-regular-font-size",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaCtaWrap",
              "name": "CTA Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "alignItems": "center",
              "padding": [28, 0, 0, 0],
              "children": [
                {
                  "type": "frame",
                  "id": "wlaCta",
                  "name": "CTA Button",
                  "width": "fit_content",
                  "fill": "$G:color-blue-600",
                  "cornerRadius": "$G:radius-xs",
                  "padding": [14, 26],
                  "layout": "horizontal",
                  "alignItems": "center",
                  "gap": "$G:spacing-2xs",
                  "children": [
                    {
                      "type": "text",
                      "id": "wlaCtaText",
                      "name": "CTA Label",
                      "fill": "$G:colors-text-reverse",
                      "content": "Link your accounts",
                      "textGrowth": "auto",
                      "fontFamily": "$G:font-family-primary",
                      "fontSize": "$G:typo-primary-base-regular-font-size",
                      "fontWeight": "500"
                    },
                    {
                      "type": "icon",
                      "id": "wlaCtaArrow",
                      "name": "CTA Arrow",
                      "width": 18,
                      "height": 18,
                      "icon": "arrow-right",
                      "library": "lucide",
                      "fill": "$G:colors-icons-reverse"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaSecurityWrap",
              "name": "Security Wrap",
              "width": "fill_container",
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "gap": "$G:spacing-2xs",
              "padding": [16, 0, 0, 0],
              "children": [
                {
                  "type": "icon",
                  "id": "wlaLock",
                  "name": "Lock",
                  "width": 14,
                  "height": 14,
                  "icon": "lock",
                  "library": "lucide",
                  "fill": "$G:colors-icons-meta"
                },
                {
                  "type": "text",
                  "id": "wlaSecurityText",
                  "name": "Security Text",
                  "fill": "$G:colors-text-meta",
                  "content": "Your financial data stays private — and it's always yours.",
                  "textGrowth": "auto",
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-xs-regular-font-size",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaLabelWrap",
              "name": "Prompt Label Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "alignItems": "center",
              "padding": [38, 0, 0, 0],
              "children": [
                {
                  "type": "text",
                  "id": "wlaPromptLabel",
                  "name": "Prompt Label",
                  "fill": "$G:colors-text-meta",
                  "content": "ONCE YOUR ACCOUNTS ARE LINKED, ASK THINGS LIKE",
                  "textAlign": "center",
                  "textGrowth": "auto",
                  "letterSpacing": 1,
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-2xs-regular-font-size",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaPromptsWrap",
              "name": "Prompts Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$G:spacing-xs",
              "padding": [14, 0, 0, 0],
              "children": [
                {
                  "type": "frame",
                  "id": "wlaPromptRow1",
                  "name": "Prompt Row 1",
                  "width": "fill_container",
                  "layout": "horizontal",
                  "gap": "$G:spacing-xs",
                  "children": [
                    {
                      "type": "frame",
                      "id": "wlaPrompt1",
                      "name": "Prompt Card 1",
                      "width": "fill_container",
                      "fill": "$G:colors-background-light",
                      "cornerRadius": "$G:radius-xs",
                      "stroke": "$G:colors-borders-light",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "padding": [14, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "gap": "$G:spacing-xs",
                      "children": [
                        {
                          "type": "frame",
                          "id": "wlaQ1",
                          "name": "Q Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "$G:color-blue-100",
                          "cornerRadius": "$G:radius-2xs",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "wlaQ1i",
                              "name": "Icon",
                              "width": 16,
                              "height": 16,
                              "icon": "trending-up",
                              "library": "lucide",
                              "fill": "$G:colors-icons-action"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "wlaPrompt1t",
                          "name": "Prompt 1 Text",
                          "fill": "$G:colors-text-body",
                          "content": "What's my biggest opportunity?",
                          "textGrowth": "auto",
                          "fontFamily": "$G:font-family-primary",
                          "fontSize": "$G:typo-primary-sm-regular-font-size",
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "wlaPrompt2",
                      "name": "Prompt Card 2",
                      "width": "fill_container",
                      "fill": "$G:colors-background-light",
                      "cornerRadius": "$G:radius-xs",
                      "stroke": "$G:colors-borders-light",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "padding": [14, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "gap": "$G:spacing-xs",
                      "children": [
                        {
                          "type": "frame",
                          "id": "wlaQ2",
                          "name": "Q Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "$G:color-blue-100",
                          "cornerRadius": "$G:radius-2xs",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "wlaQ2i",
                              "name": "Icon",
                              "width": 16,
                              "height": 16,
                              "icon": "chart-pie",
                              "library": "lucide",
                              "fill": "$G:colors-icons-action"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "wlaPrompt2t",
                          "name": "Prompt 2 Text",
                          "fill": "$G:colors-text-body",
                          "content": "Am I over-concentrated?",
                          "textGrowth": "auto",
                          "fontFamily": "$G:font-family-primary",
                          "fontSize": "$G:typo-primary-sm-regular-font-size",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wlaPromptRow2",
                  "name": "Prompt Row 2",
                  "width": "fill_container",
                  "layout": "horizontal",
                  "gap": "$G:spacing-xs",
                  "children": [
                    {
                      "type": "frame",
                      "id": "wlaPrompt3",
                      "name": "Prompt Card 3",
                      "width": "fill_container",
                      "fill": "$G:colors-background-light",
                      "cornerRadius": "$G:radius-xs",
                      "stroke": "$G:colors-borders-light",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "padding": [14, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "gap": "$G:spacing-xs",
                      "children": [
                        {
                          "type": "frame",
                          "id": "wlaQ3",
                          "name": "Q Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "$G:color-blue-100",
                          "cornerRadius": "$G:radius-2xs",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "wlaQ3i",
                              "name": "Icon",
                              "width": 16,
                              "height": 16,
                              "icon": "wallet",
                              "library": "lucide",
                              "fill": "$G:colors-icons-action"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "wlaPrompt3t",
                          "name": "Prompt 3 Text",
                          "fill": "$G:colors-text-body",
                          "content": "Am I holding too much cash?",
                          "textGrowth": "auto",
                          "fontFamily": "$G:font-family-primary",
                          "fontSize": "$G:typo-primary-sm-regular-font-size",
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "wlaPrompt4",
                      "name": "Prompt Card 4",
                      "width": "fill_container",
                      "fill": "$G:colors-background-light",
                      "cornerRadius": "$G:radius-xs",
                      "stroke": "$G:colors-borders-light",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "padding": [14, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "gap": "$G:spacing-xs",
                      "children": [
                        {
                          "type": "frame",
                          "id": "wlaQ4",
                          "name": "Q Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "$G:color-blue-100",
                          "cornerRadius": "$G:radius-2xs",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "wlaQ4i",
                              "name": "Icon",
                              "width": 16,
                              "height": 16,
                              "icon": "chart-column",
                              "library": "lucide",
                              "fill": "$G:colors-icons-action"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "wlaPrompt4t",
                          "name": "Prompt 4 Text",
                          "fill": "$G:colors-text-body",
                          "content": "Where is my money going?",
                          "textGrowth": "auto",
                          "fontFamily": "$G:font-family-primary",
                          "fontSize": "$G:typo-primary-sm-regular-font-size",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaCueWrap",
              "name": "Cue Wrap",
              "width": "fill_container",
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "gap": "$G:spacing-2xs",
              "padding": [32, 0, 0, 0],
              "children": [
                {
                  "type": "text",
                  "id": "wlaCueText",
                  "name": "Cue Text",
                  "fill": "$G:colors-text-meta",
                  "content": "Or keep asking questions in the chat",
                  "textGrowth": "auto",
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-base-regular-font-size",
                  "fontWeight": "500"
                },
                {
                  "type": "icon",
                  "id": "wlaCueArrow",
                  "name": "Cue Arrow",
                  "width": 20,
                  "height": 20,
                  "icon": "arrow-right",
                  "library": "lucide",
                  "fill": "$G:colors-icons-meta"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wlaDisclaimerWrap",
              "name": "Disclaimer Wrap",
              "width": "fill_container",
              "layout": "vertical",
              "alignItems": "center",
              "padding": [56, 0, 0, 0],
              "children": [
                {
                  "type": "text",
                  "id": "wlaDisclaimer",
                  "name": "Disclaimer",
                  "fill": "$G:colors-text-meta",
                  "content": "Evergreen.ai provides information to help you understand your finances. It is not a substitute for professional financial advice.",
                  "textAlign": "center",
                  "textGrowth": "fixed-width",
                  "width": 560,
                  "lineHeight": 1.5,
                  "fontFamily": "$G:font-family-primary",
                  "fontSize": "$G:typo-primary-2xs-regular-font-size",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "imports": {
    "G": "../../design-system/in-progress/hemlock-library.lib.pen"
  }
}
