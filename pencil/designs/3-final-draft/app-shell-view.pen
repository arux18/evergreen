                    {
                      "type": "frame",
                      "id": "o4iVPb",
                      "name": "Chat / Close Button / Default",
                      "context": "Close button for the chat panel. 28×28, r6, transparent background. Use in the chat header to dismiss the panel. States: default, hover, pressed.",
