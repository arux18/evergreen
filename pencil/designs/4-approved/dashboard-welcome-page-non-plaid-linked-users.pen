                      "id": "lyjWG",
                      "name": "chip1",
                      "context": "Prompt chip (default state). Pill-shaped suggestion button shown below the input field. Displays a pre-written financial question the user can tap to send. Font: 14px Geist, fill $chat.chip.bg, border $chat.chip.border, radius $chat.chip.radius. States: default, hover, pressed.",
                      "fill": "$chat.chip.bg",
                      "cornerRadius": "$chat.chip.radius",
                      "stroke": "$chat.chip.border",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "padding": [
                        12,
                        16
                      ],
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "n6Zpm",
                          "name": "label",
                          "fill": "$chat.text.secondary",
                          "content": "What's a donor-advised fund?",
                          "lineHeight": 1.25,
                          "textAlign": "center",
                          "fontFamily": "Heebo",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "S0zta",
              "name": "Chat / Input Field / Empty",
              "context": "Input Field / Empty — Shown when no text has been entered. Contains placeholder text and the button row (voice, send disabled). Outer padding: 12t/20r/20b/20l. Inner field: $chat.input.bg, border $chat.input.border, radius $chat.input.radius.",
              "width": "fill_container",
              "stroke": {
                "type": "color",
                "color": "#E8E6E0",
                "enabled": false
              },
              "strokeWidth": {
                "top": 0.5
              },
              "strokeAlignment": "inner",
              "strokeLinejoin": "round",
              "layout": "vertical",
              "gap": 12,
              "padding": [
                12,
                20,
                20,
                20
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "k9qyW2",
                  "name": "inputField",
                  "width": "fill_container",
                  "fill": "$chat.input.bg",
                  "cornerRadius": "$chat.input.radius",
                  "stroke": "$chat.input.border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 24,
                  "padding": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "GSvkA",
                      "name": "placeholder",
                      "fill": "$chat.text.placeholder",
                      "content": "Ask me any financial question...",
                      "fontFamily": "Heebo",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "DxuR6",
                      "name": "rowButtons",
                      "width": "fill_container",
                      "gap": 8,
                      "justifyContent": "end",
                      "children": [
                        {
                          "type": "frame",
                          "id": "O8Zh4",
                          "name": "Chat / Voice Button / Default",
                          "context": "Voice input button (default state). 34×34 pill, transparent background with border. Tapping starts speech-to-text recording via Cartesia. Place in input field secondary buttons area. States: default, hover, pressed, active (recording).",
                          "width": 34,
                          "height": 34,
                          "fill": "#00000000",
                          "cornerRadius": 9999,
                          "stroke": "$chat.chip.border",
                          "strokeWidth": 1,
                          "strokeAlignment": "inner",
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "C4SdG",
                              "name": "icon",
                              "width": 16,
                              "height": 16,
                              "icon": "mic",
                              "library": "lucide",
                              "fill": "$chat.icon"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MY6ZF",
                          "name": "Chat / Send Button / Disabled",
                          "context": "Disabled state of the send button. Shown when the input field is empty or processing. 34×34 pill, muted fill ($chat.send.bg.disabled) with white icon. States: disabled.",
                          "width": 34,
                          "height": 34,
                          "fill": "$chat.send.bg.disabled",
                          "cornerRadius": 9999,
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "p5wcZ",
                              "name": "sendIcon",
                              "width": 20,
                              "height": 20,
                              "icon": "arrow-up",
                              "library": "lucide",
                              "fill": "#FFFFFF"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
