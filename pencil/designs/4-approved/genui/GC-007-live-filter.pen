{
 "version": "2.17",
 "imports": {
  "y": "../../../design-system/in-progress/hemlock-library.lib.pen"
 },
 "themes": {
  "🎨 Colors": [
   "Light",
   "Dark"
  ],
  "🆎 Typography": [
   "desktop",
   "mobile"
  ],
  "↔️ Spacing/Radius": [
   "Default"
  ]
 },
 "variables": {
  "sem-tableHeaderBandTop": {
   "type": "color",
   "value": [
    {
     "value": "#F7F5F0",
     "theme": {
      "🎨 Colors": "Light"
     }
    },
    {
     "value": "#172642",
     "theme": {
      "🎨 Colors": "Dark"
     }
    }
   ]
  },
  "sem-tableHeaderBandBottom": {
   "type": "color",
   "value": [
    {
     "value": "#EDEAE3",
     "theme": {
      "🎨 Colors": "Light"
     }
    },
    {
     "value": "#1D2E50",
     "theme": {
      "🎨 Colors": "Dark"
     }
    }
   ]
  },
  "text-size-caption": {
   "type": "number",
   "value": [
    {
     "value": 13,
     "theme": {
      "🆎 Typography": "desktop"
     }
    },
    {
     "value": 13,
     "theme": {
      "🆎 Typography": "mobile"
     }
    }
   ]
  },
  "radius-menu": {
   "type": "number",
   "value": [
    {
     "value": 6,
     "theme": {
      "↔️ Spacing/Radius": "Default"
     }
    }
   ]
  }
 },
 "fonts": [
  {
   "name": "Heebo",
   "url": "../../fonts/Heebo-VariableFont_wght.ttf",
   "weight": [
    100,
    900
   ],
   "axes": [
    {
     "tag": "wght",
     "start": 100,
     "end": 900
    }
   ]
  }
 ],
 "children": [
  {
   "type": "frame",
   "id": "default",
   "name": "default",
   "x": 0,
   "y": 0,
   "width": 300,
   "height": 190,
   "layout": "none",
   "clip": true,
   "theme": {
    "🎨 Colors": "Light",
    "🆎 Typography": "desktop",
    "↔️ Spacing/Radius": "Default"
   },
   "fill": "$y:sem-background-surface",
   "children": [
    {
     "type": "text",
     "id": "default-label",
     "name": "field label",
     "layoutPosition": "absolute",
     "x": 0,
     "y": -0.5,
     "fontFamily": "$y:font-primary",
     "fontSize": "$y:text-size-2xs",
     "fontWeight": "500",
     "lineHeight": "$y:line-height-base",
     "letterSpacing": 0.55,
