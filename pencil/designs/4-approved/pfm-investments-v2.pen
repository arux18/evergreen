          "children": [
            {
              "type": "frame",
              "id": "a7O6V",
              "name": "Chat / Header",
              "context": "Chat panel header. Full-width bar at the top of the chat panel. Contains the chat title (Noto Serif 16px) and the close button. Always present inside the Panel component regardless of content state. Padding: 16v/20h, bottom border 0.5px $chat.divider.",
              "width": "fill_container",
              "stroke": "$chat.divider",
              "strokeWidth": {
                "bottom": 0.5
              },
